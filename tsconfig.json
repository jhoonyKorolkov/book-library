{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "commonjs",
    "target": "es6",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "strictNullChecks": false,
    "noImplicitReturns": true
    // "pretty": true,
    // "preserveConstEnums": true
  },
  "include": ["src/**/*.ts", "src/controllers/books.js", "src/models/books.js"],
  "exclude": ["node_modules", "dist"]
}
